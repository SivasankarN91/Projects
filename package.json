{
  "name": "automation-testing-framework",
  "version": "1.0.0",
  "description": "Comprehensive automation testing environment for emoji physics simulator",
  "main": "index.html",
  "scripts": {
    "test": "node tests/test-runner.js",
    "test:e2e": "playwright test",
    "test:unit": "jest",
    "test:all": "npm run test:unit && npm run test:e2e",
    "test:scenario": "node tests/scenario-runner.js",
    "test:report": "node tests/generate-report.js",
    "serve": "npx http-server -p 8080",
    "install-browsers": "npx playwright install"
  },
  "keywords": [
    "testing",
    "automation",
    "playwright",
    "jest",
    "e2e"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "http-server": "^14.1.1"
  }
}
